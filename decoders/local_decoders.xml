<!--
  - Allowed static fields:
  - location   - where the log came from (only on FTS)
  - srcuser    - extracts the source username
  - dstuser    - extracts the destination (target) username
  - user       - an alias to dstuser (only one of the two can be used)
  - srcip      - source ip
  - dstip      - dst ip
  - srcport    - source port
  - dstport    - destination port
  - protocol   - protocol
  - id         - event id
  - url        - url of the event
  - action     - event action (deny, drop, accept, etc)
  - status     - event status (success, failure, etc)
  - extra_data - Any extra data
-->

<!-- 
  Castle Decoder
-->
<decoder name="Castle_decoder">
  <prematch>CastleLogger:</prematch>
</decoder>

<!-- Log Type -->
<decoder name="Castle_child">
  <parent>Castle_decoder</parent>
  <regex type="pcre2">CastleLogger: (\S+)</regex>
  <order>Castle.log_type</order>
</decoder>

<!-- Protected Domain address -->
<decoder name="Castle_child">
  <parent>Castle_decoder</parent>
  <regex type="pcre2">WhiteKnight@(\S+)</regex>
  <order>Castle.protected_domain</order>
</decoder>

<!-- Full Log event -->
<decoder name="Castle_child">
  <parent>Castle_decoder</parent>
  <regex type="pcre2">castle-event: (.*)</regex>
  <order>Castle.whiteknight_log</order>
</decoder>

<!-- Start time of malware scan -->
<decoder name="Castle_child">
  <parent>Castle_decoder</parent>
  <regex type="pcre2">start-time: (\S+) (\S+)</regex>
  <order>Castle.start_time</order>
</decoder>

<!-- End time of malware scan -->
<decoder name="Castle_child">
  <parent>Castle_decoder</parent>
  <regex type="pcre2">end-time: (\S+) (\S+)</regex>
  <order>Castle.end_time</order>
</decoder>

<!-- Total time of malware scan -->
<decoder name="Castle_child">
  <parent>Castle_decoder</parent>
  <regex type="pcre2">total-time: (\d+)</regex>
  <order>Castle.total_time</order>
</decoder>

<!-- Base directory of malware scan -->
<decoder name="Castle_child">
  <parent>Castle_decoder</parent>
  <regex type="pcre2">base-directory: (\S+)</regex>
  <order>Castle.base_directory</order>
</decoder>

<!-- Total directories scanned during malware scan -->
<decoder name="Castle_child">
  <parent>Castle_decoder</parent>
  <regex type="pcre2">total-directories-scanned: (\d+)</regex>
  <order>Castle.total_directories_scanned</order>
</decoder>

<!-- Total files scanned during malware scan -->
<decoder name="Castle_child">
  <parent>Castle_decoder</parent>
  <regex type="pcre2">total-files-scanned: (\d+)</regex>
  <order>Castle.total_files_scanned</order>
</decoder>

<!-- Total malware identified -->
<decoder name="Castle_child">
  <parent>Castle_decoder</parent>
  <regex type="pcre2">total-malware-identified: (\d+)</regex>
  <order>Castle.total_malware_identified</order>
</decoder>

<!-- Error log from webserver/whiteknight -->
<decoder name="Castle_child">
  <parent>Castle_decoder</parent>
  <regex type="pcre2">error-log: (.*)</regex>
  <order>Castle.error_log</order>
</decoder>

<!-- Threat type from active-protection -->
<decoder name="Castle_child">
  <parent>Castle_decoder</parent>
  <regex type="pcre2">threat: (\S+)</regex>
  <order>Castle.threat_type</order>
</decoder>

<!-- IP of Log from Active-protection -->
<decoder name="Castle_child">
  <parent>Castle_decoder</parent>
  <regex type="pcre2">attackerIP: (\d+\.\d+\.\d+\.\d+)</regex>
  <order>Castle.attacker_ip</order>
</decoder>

<!-- Browser type from active-protection log -->
<decoder name="Castle_child">
  <parent>Castle_decoder</parent>
  <regex type="pcre2">browser: (\S+)</regex>
  <order>Castle.browser</order>
</decoder>

<!-- Operating System from active-protection log -->
<decoder name="Castle_child">
  <parent>Castle_decoder</parent>
  <regex type="pcre2">os: (\S+)</regex>
  <order>Castle.operating_system</order>
</decoder>

<!-- Browser type from active-protection log -->
<decoder name="Castle_child">
  <parent>Castle_decoder</parent>
  <regex type="pcre2">referer: (\S+)</regex>
  <order>Castle.referer</order>
</decoder>
<!--
  End Castle Decoder
-->

