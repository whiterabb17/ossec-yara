<!-- Castle Rules -->
<group name="castle,whiteknight,syslog">
  <rule id="189000" level="0">
    <decoded_as>Castle_decoder</decoded_as>
    <description>Castle grouping rule</description>
  </rule>
  <rule id="189001" level="11">
    <if_sid>189000</if_sid>
    <match>CastleLogger: Active Protection</match>
    <!-- <description>$(Castle.whiteknight_log)</description> -->
    <description>WhiteKnight at $(Castle.protected_domain) blocked a $(Castle.threat_type) from $(Castle.attacker_ip) using $(Castle.browser) on $(Castle.operating_system)</description>
  </rule>
  <rule id="189002" level="11">
    <if_sid>189000</if_sid>
    <field name="Castle.total_files_scanned">\.</field>
    <match>CastleLogger: Malware Scan</match>
    <description>WhiteKnight at $(Castle.protected_domain) finished Malware scan. Files scanned: $(Castle.total_files_scanned). Suspicious Files: $(Castle.total_malware_identified)</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1203</id>
    </mitre>
  </rule>
  <rule id="189003" level="11">
    <if_sid>189000</if_sid>
    <field name="Castle.error_log">\.</field>
    <match>CastleLogger: Error Log</match>
    <description>WhiteKnight at $(Castle.protected_domain) has detected a website error: $(Castle.error_location)</description>
    <options>no_full_log</options>
  </rule>
  <rule id="189004" level="15">
    <if_sid>189001</if_sid>
    <match>threat: SQL Injection</match>
    <description>WhiteKnight at $(Castle.protected_domain) has blocked an SQLi Attack from $(Castle.attacker_ip)</description>
    <mitre>
      <id>T1203</id>
    </mitre>
  </rule>
  <rule id="189005" level="15">
    <if_sid>189001</if_sid>
    <match>threat: Cross Site-Scripting</match>
    <description>WhiteKnight at $(Castle.protected_domain) has blocked an XSS Attack from $(Castle.attacker_ip)</description>
    <mitre>
      <id>T1203</id>
    </mitre>
  </rule>
</group>
<!-- End Castle Rules -->

